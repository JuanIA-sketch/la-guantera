# La Guantera - variables de entorno
# Copiar a .env y llenar con valores reales. .env nunca se sube al repo (ver .gitignore).
# Recordatorio: nunca pegar secretos reales dentro de una sesion de Claude Code.
# Usar siempre fixtures sinteticos para pruebas.

# --- Supabase (mismo proyecto que charly-prospecting, tabla nueva: guantera_chunks) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de embeddings (ver docs/BRIEF.md seccion 7.3 - decision pendiente) ---
# Default recomendado: OpenAI text-embedding-3-small
OPENAI_API_KEY=

# --- Telegram (bot de consulta + ingesta manual) ---
# Decision pendiente: reutilizar bot existente o crear uno dedicado (ver docs/BRIEF.md seccion 9.2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub ---
# GITHUB_WEBHOOK_SECRET: valida el payload que llega via n8n (ingesta hacia adelante)
# GITHUB_TOKEN: personal access token con permiso de lectura, para el backfill via API
#   (son dos cosas distintas - el webhook secret no sirve para leer historial)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# --- Fase 2: n8n / Notion (sync periodico) ---
N8N_BASE_URL=
N8N_API_KEY=
NOTION_API_KEY=

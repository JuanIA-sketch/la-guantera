# La Guantera - variables de entorno
# Copiar a .env y llenar con valores reales. .env nunca se sube al repo (ver .gitignore).
# Recordatorio: nunca pegar secretos reales dentro de una sesion de Claude Code.
# Usar siempre fixtures sinteticos para pruebas.

# --- Supabase (mismo proyecto que charly-prospecting, tabla nueva: guantera_chunks) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string directa de Postgres (Supabase > Settings > Database > Connection string).
# La usa unicamente `npm run setup` para aplicar scripts/schema.sql sin copiar/pegar SQL a mano.
SUPABASE_DB_URL=

# --- OpenAI (embeddings text-embedding-3-small + transcripcion de voz gpt-4o-mini-transcribe) ---
OPENAI_API_KEY=

# --- Telegram (bot dedicado de La Guantera, creado en BotFather) ---
TELEGRAM_BOT_TOKEN=
# chat_id autorizados, separados por coma, empezando por el de Charly.
# El bot IGNORA cualquier mensaje de un chat_id que no este en esta lista.
TELEGRAM_CHAT_IDS=

# --- GitHub ---
# GITHUB_TOKEN: personal access token con permiso de LECTURA sobre los repos de GITHUB_REPOS
#   (lo usa el backfill via API - el webhook secret de abajo no sirve para leer historial)
GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET: secreto compartido que n8n agrega como header X-Guantera-Secret
#   al reenviar los eventos del GitHub Trigger hacia POST /ingesta/github
GITHUB_WEBHOOK_SECRET=
# Repos a indexar (backfill + ingesta hacia adelante), separados por coma, formato owner/repo
# Ejemplo: JuanIA-sketch/la-alarma,JuanIA-sketch/el-arquitecto
GITHUB_REPOS=

# --- Servicio HTTP interno (listener para n8n; solo se expone en 172.17.0.1 en el VPS) ---
PUERTO_HTTP=3012

# --- Busqueda semantica ---
# Similitud coseno minima (0-1) para considerar un chunk relevante
UMBRAL_SIMILITUD=0.35

# --- Fase 2: n8n / Notion (sync periodico) ---
N8N_BASE_URL=
N8N_API_KEY=
NOTION_API_KEY=
{
  "name": "la-guantera",
  "version": "0.1.0",
  "description": "Memoria estructurada y consultable del ecosistema de Charly.marketing, con busqueda semantica por embeddings.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx scripts/setup.ts",
    "backfill": "tsx scripts/backfill.ts"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@supabase/supabase-js": "2.110.7",
    "dotenv": "17.4.2",
    "grammy": "1.45.0",
    "ignore": "7.0.6",
    "openai": "6.47.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
